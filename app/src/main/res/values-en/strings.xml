    <!-- Privacy Policy Content -->
    <string name="privacy_intro_title">1. Introduction</string>
    <string name="privacy_intro_content">Welcome to Tempus - Smart Time Management App. We are committed to protecting your privacy and personal data. This policy describes how we collect, use, and protect your information.</string>
    
    <string name="privacy_info_title">2. Information We Collect</string>
    <string name="privacy_info_sub1">2.1. Account Information</string>
    <string name="privacy_info_content1">• Email and username upon registration\n• Encrypted password\n• Profile information (optional)</string>
    <string name="privacy_info_sub2">2.2. Usage Data</string>
    <string name="privacy_info_content2">• Schedules and tasks you create\n• Personalized wake/sleep times\n• App settings</string>
    <string name="privacy_info_sub3">2.3. Device Information</string>
    <string name="privacy_info_content3">• Device type and operating system\n• Local time zone\n• Notification token (if enabled)</string>
    
    <string name="privacy_usage_title">3. How We Use Information</string>
    <string name="privacy_usage_content">• Provide and improve services\n• Sync data across devices\n• Send reminder notifications (if permitted)\n• Analyze to improve user experience\n• Technical support when needed</string>
    
    <string name="privacy_security_title">4. Data Security</string>
    <string name="privacy_security_content">We implement advanced security measures:\n\n• Data encryption in transit (TLS/SSL)\n• Secure storage on Supabase with encryption\n• Biometric authentication for sensitive actions\n• No sharing data with third parties for advertising purposes</string>
    
    <string name="privacy_rights_title">5. Your Rights</string>
    <string name="privacy_rights_content">You have the right to:\n\n• Access and view your data\n• Export data (JSON/CSV)\n• Edit or delete personal information\n• Permanently delete account\n• Opt-out of notifications</string>
    
    <string name="privacy_storage_title">6. Data Retention and Deletion</string>
    <string name="privacy_storage_content">• Data is stored on Supabase servers\n• You can delete all data in Settings\n• After account deletion, data is removed within 30 days\n• System logs may be retained up to 90 days</string>
    
    <string name="privacy_changes_title">7. Policy Changes</string>
    <string name="privacy_changes_content">We may update this policy from time to time. You will be notified of significant changes via the app or email.</string>
    
    <string name="privacy_contact_title">8. Contact Us</string>
    <string name="privacy_contact_content">If you have questions about privacy policy, please contact:\n\n📧 Email: support@tempus-app.com\n🌐 Website: https://tempus-app.com</string>

    <!-- Terms of Service Content -->
    <string name="terms_accept_title">1. Acceptance of Terms</string>
    <string name="terms_accept_content">By downloading, installing, or using the Tempus app, you agree to comply with the terms and conditions set forth in this document.</string>
    
    <string name="terms_desc_title">2. Service Description</string>
    <string name="terms_desc_content">Tempus is a time management app providing features:\n\n• Create and manage personal schedules\n• Personalize daily habits\n• Cloud data synchronization\n• Smart reminders\n• Time analysis and statistics</string>
    
    <string name="terms_account_title">3. User Account</string>
    <string name="terms_account_content">• You must provide accurate information when registering\n• You are responsible for account security\n• Each account is for single user only\n• We reserve the right to ban violating accounts</string>
    
    <string name="terms_rules_title">4. Usage Rules</string>
    <string name="terms_rules_content">You commit NOT to:\n\n• Use app for illegal purposes\n• Attempt unauthorized system access\n• Copy, distribute or modify the app\n• Harm other users\n• Infringe intellectual property rights</string>
    
    <string name="terms_ip_title">5. Intellectual Property</string>
    <string name="terms_ip_content">• Tempus and all content are our property\n• You are granted a limited license\n• Cannot copy source code or design\n• Logo, brand belong to Tempus</string>
    
    <string name="terms_liability_title">6. Limitation of Liability</string>
    <string name="terms_liability_content">• App provided "as is"\n• We do not guarantee uninterrupted operation\n• Not responsible for data loss due to user error\n• Total liability not exceeding service fees (if any)</string>
    
    <string name="terms_termination_title">7. Termination</string>
    <string name="terms_termination_content">• You can stop using at any time\n• We may terminate service with 30 days notice\n• Violating accounts may be banned immediately\n• After termination, you have 30 days to export data</string>
    
    <string name="terms_changes_title">8. Terms Changes</string>
    <string name="terms_changes_content">We reserve the right to modify these terms. Significant changes will be notified 14 days in advance. Continued use implies acceptance of new terms.</string>
    
    <string name="terms_law_title">9. Governing Law</string>
    <string name="terms_law_content">These terms are governed by the laws of Vietnam. Any disputes will be resolved at competent courts in Vietnam.</string>
    
    <string name="terms_contact_title">10. Contact</string>
    <string name="terms_contact_content">Questions about terms of service:\n\n📧 Email: legal@tempus-app.com\n🌐 Website: https://tempus-app.com/terms</string>

