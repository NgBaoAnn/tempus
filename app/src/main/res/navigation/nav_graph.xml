<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/timerFragment">

    <fragment
        android:id="@+id/timerFragment"
        android:name="com.projectapp.tempus.TimerFragment"
        android:label="fragment_timer"
        tools:layout="@layout/fragment_timer">
        
        <action
            android:id="@+id/action_timerFragment_to_notesFragment"
            app:destination="@id/notesFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/notesFragment"
        android:name="com.projectapp.tempus.ui.notes.NotesFragment"
        android:label="Quick Notes" />
    <fragment
        android:id="@+id/timelineFragment"
        android:name="com.projectapp.tempus.TimelineFragment"
        android:label="fragment_timeline"
        tools:layout="@layout/fragment_timeline">

        <argument
            android:name="date"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />

        <action
            android:id="@+id/action_timelineFragment_to_editScheduleFragment"
            app:destination="@id/editScheduleFragment" />
            
        <action
            android:id="@+id/action_timelineFragment_to_gardenFragment"
            app:destination="@id/gardenFragment" />

    </fragment>
    <fragment
        android:id="@+id/aiFragment"
        android:name="com.projectapp.tempus.ui.ai.AIFragment"
        android:label="fragment_ai"
        tools:layout="@layout/fragment_ai" />
    <fragment
        android:id="@+id/statisticsFragment"
        android:name="com.projectapp.tempus.StatisticsFragment"
        android:label="fragment_statistics"
        tools:layout="@layout/fragment_statistics">
        
        <action
            android:id="@+id/action_statistics_to_heatmap"
            app:destination="@id/heatmapFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.projectapp.tempus.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/editScheduleFragment"
        android:name="com.projectapp.tempus.ui.timeline.EditScheduleFragment"
        android:label="Edit Schedule"
        tools:layout="@layout/fragment_edit_schedule">

        <argument
            android:name="taskId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
            
        <argument
            android:name="selectedDate"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/gardenFragment"
        android:name="com.projectapp.tempus.ui.garden.GardenFragment"
        android:label="Garden"
        tools:layout="@layout/fragment_garden" />

    <fragment
        android:id="@+id/socialFragment"
        android:name="com.projectapp.tempus.ui.social.SocialFragment"
        android:label="Friends" />

    <fragment
        android:id="@+id/heatmapFragment"
        android:name="com.projectapp.tempus.ui.heatmap.HeatmapFragment"
        android:label="Productivity Heatmap">
        
        <argument
            android:name="initialMonth"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
            
        <action
            android:id="@+id/action_heatmap_to_editSchedule"
            app:destination="@id/editScheduleFragment" />
    </fragment>
</navigation>